// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  // Inside src/ on purpose: with the client outside the compiler's rootDir,
  // tsc widens the output tree and `node dist/main` no longer resolves.
  output       = "../src/generated/prisma"
  // NestJS compiles to CommonJS (tsconfig "module": "nodenext", no "type":
  // "module" in package.json). Without this the generated client emits
  // `import.meta.url` and will not compile.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts & auth
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(uuid())
  firstName     String?
  lastName      String?
  middleName    String?
  username      String? @unique
  email         String  @unique
  emailVerified Boolean @default(false)

  image         String?
  phoneNumber   String?
  // Collected at signup as contact data only. No SMS OTP in this phase, so this
  // stays false until we add a verification flow.
  phoneVerified Boolean @default(false)
  country       String?

  role Role @default(ARTIST)

  onboardingCompleted Boolean @default(false)

  // Terms of service. Artists upload master recordings, so we record which
  // version of the terms they agreed to and when.
  acceptedTermsAt DateTime?
  termsVersion    String?

  // Account moderation
  accountStatus          AccountStatus @default(ACTIVE)
  accountStatusReason    String?
  accountStatusUpdatedAt DateTime?

  // Soft delete. Apple requires in-app account deletion, so the delete endpoint
  // sets these, anonymises PII, and schedules asset cleanup.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  googleId String? @unique
  password String?
  provider String  @default("local")

  mustChangePassword Boolean @default(false)

  /**
   * Whether transactional mail about their own catalogue reaches them. The
   * in-app centre is not optional — it is a record, and turning it off would
   * mean an artist could never find out why a release came back.
   */
  emailNotifications Boolean @default(true)

  resetOTP       String?
  resetOTPExpiry DateTime?

  emailVerificationOTP       String?
  emailVerificationOTPExpiry DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin      Admin?
  artist     Artist?
  ownedLabel Label?
  sessions   Session[]
  assets     MediaAsset[]

  // Written only when this user is an administrator. Kept on User rather than
  // Admin so a decision survives the Admin row being changed underneath it.
  adminActions     AdminAction[]  @relation("AdminActor")
  reviewedReleases Release[]      @relation("ReleaseReviewer")
  notifications    Notification[]

  // Access this person holds on someone else's roster artist, and the invites
  // they have sent out. Two relations because a label owner is on both sides.
  artistSeats      ArtistSeat[]   @relation("SeatHolder")
  sentArtistSeats  ArtistSeat[]   @relation("SeatInviter")

  @@index([role])
  @@index([accountStatus])
}

enum Role {
  ARTIST
  LABEL
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// One row per signed-in device. Replaces a single refreshToken column on User,
// which would log a user out of their phone whenever they signed in anywhere
// else — not acceptable for a mobile-first product.
model Session {
  id               String @id @default(uuid())
  userId           String
  // SHA-256 of the refresh token. The token itself carries this session's id,
  // so refresh is an indexed lookup by id followed by a constant-time compare —
  // no table scan, and a stolen database row cannot be replayed as a token.
  refreshTokenHash String

  deviceName String?
  platform   String? // "ios" | "android" | "web"
  appVersion String?
  ipAddress  String?
  userAgent  String?

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Admin {
  id        String        @id @default(uuid())
  userId    String        @unique
  position  AdminPosition @default(ADMIN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AdminPosition {
  SUPER_ADMIN
  ADMIN
  FINANCE
  SUPPORT
  MODERATOR
  VIEWER
}

// ---------------------------------------------------------------------------
// Roster: labels and artists
// ---------------------------------------------------------------------------

// Scaffolded now, not exposed in this phase. Costs one table and a nullable FK,
// and saves reworking every release query when the label dashboard arrives.
/**
 * A person's access to one roster artist.
 *
 * Deliberately separate from `Artist.userId`. That field says "this artist row
 * IS this user" — one to one, and unique, so it can hold neither a manager who
 * looks after three artists nor a revocation that should not erase the identity
 * itself. A seat is access: granted, scoped, and taken back, while the label
 * keeps the catalogue.
 */
model ArtistSeat {
  id       String @id @default(uuid())
  artistId String

  // Bound when the invite is accepted. Null until then, because the person
  // invited may not have an account yet.
  userId String?

  // Who it was sent to. Kept after acceptance so a revoked seat can be
  // re-invited, and so the label sees who it invited rather than a null.
  email  String
  role   SeatRole   @default(VIEWER)
  status SeatStatus @default(PENDING)

  // bcrypt of the six-digit code, the same shape as the auth OTPs — a stolen
  // row must not be replayable as an invite.
  inviteCodeHash String?
  expiresAt      DateTime?
  acceptedAt     DateTime?

  invitedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist    Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User?  @relation("SeatHolder", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("SeatInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  // One outstanding seat per address per artist. Re-inviting updates the row
  // rather than stacking codes that all still work.
  @@unique([artistId, email])
  @@index([userId])
}

enum SeatRole {
  /** Reads the artist and their catalogue. Changes nothing. */
  VIEWER
  /** Also creates and edits releases for that artist. */
  MANAGER
}

enum SeatStatus {
  PENDING
  ACTIVE
  REVOKED
}

model Label {
  id      String  @id @default(uuid())
  ownerId String  @unique
  name    String
  slug    String  @unique
  country String?
  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  artists  Artist[]
  releases Release[]
}

model Artist {
  id String @id @default(uuid())

  // Nullable because a label will eventually add roster artists who have no
  // login of their own. In this phase every artist row has a user.
  userId String? @unique

  labelId String?

  // The "artist name" collected at signup.
  stageName String
  slug      String  @unique
  legalName String?
  bio       String?
  // A URL that came from somewhere else — a Google profile picture, say. An
  // avatar UPLOADED to FRNDSHQ goes through `avatarAsset` instead, because the
  // bucket is private and a signed URL would be dead within five minutes.
  avatarUrl String?
  // @unique so one upload backs one artist, matching Release.artworkAssetId.
  avatarAssetId String? @unique
  country   String?

  // Set once we can match a catalogue to a streaming profile. Unused until the
  // analytics phase, but this is where those IDs belong.
  spotifyArtistId    String?
  appleMusicArtistId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       Label?      @relation(fields: [labelId], references: [id], onDelete: SetNull)
  avatarAsset MediaAsset? @relation("ArtistAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  seats       ArtistSeat[]
  releases Release[]

  @@index([labelId])
  @@index([stageName])
}

// ---------------------------------------------------------------------------
// Catalogue: releases and tracks
// ---------------------------------------------------------------------------

// A single upload in the app creates one Release of type SINGLE holding one
// Track. The app can hide the word "release" entirely — the structure exists so
// EPs, albums and UPC assignment don't require a migration later.
model Release {
  id       String  @id @default(uuid())
  artistId String
  labelId  String?

  title       String
  type        ReleaseType @default(SINGLE)
  // Assigned by the distribution partner at delivery time. Null until then.
  upc         String?     @unique
  releaseDate DateTime?
  language    String?

  primaryGenre   String?
  secondaryGenre String?

  // Copyright lines printed on DSP pages, e.g. "2026 FRNDSHQ".
  cLine String?
  pLine String?

  artworkAssetId String? @unique

  status       ReleaseStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewNotes  String?
  // The administrator behind the current status. Denormalised out of the
  // action log on purpose: "who approved this" is asked every time the release
  // is opened, and it should not need a second query to answer.
  reviewedById String?

  // Captured when the artist ticks "I own or control the rights to this
  // recording" at submission. Do not accept a submission without it.
  rightsConfirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist        Artist               @relation(fields: [artistId], references: [id], onDelete: Cascade)
  label         Label?               @relation(fields: [labelId], references: [id], onDelete: SetNull)
  reviewedBy    User?                @relation("ReleaseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  artworkAsset  MediaAsset?          @relation("ReleaseArtwork", fields: [artworkAssetId], references: [id], onDelete: SetNull)
  tracks        Track[]
  contributors  ReleaseContributor[]
  notifications Notification[]

  @@index([artistId, status])
  @@index([labelId])
  @@index([createdAt])
}

enum ReleaseType {
  SINGLE
  EP
  ALBUM
}

enum ReleaseStatus {
  DRAFT // being filled in
  SUBMITTED // artist has submitted, awaiting review
  IN_REVIEW // admin or automated QC running
  READY // passed review, stored, going no further in this phase
  REJECTED // failed QC or moderation

  // Distribution phase only. Nothing in this build ever sets these — the app
  // must never tell an artist their music is live while they are unreachable.
  DELIVERING
  LIVE
  TAKEN_DOWN
}

model Track {
  id        String @id @default(uuid())
  releaseId String

  title        String
  versionTitle String? // "Radio Edit", "Sped Up", etc.
  trackNumber  Int     @default(1)
  discNumber   Int     @default(1)

  isrc     String? @unique
  explicit Boolean @default(false)
  lyrics   String?

  audioAssetId String? @unique

  // Written by the validation worker after upload. lufs and peakDb stay null
  // until loudness analysis exists — that needs a full decode, not a probe.
  durationSec Int?
  sampleRate  Int?
  bitDepth    Int?
  channels    Int?
  lufs        Float?
  peakDb      Float?

  status             TrackStatus @default(PENDING_UPLOAD)
  processingError    String?
  // Guards the retry sweep: a file that kills the probe every time must not be
  // picked up forever.
  processingAttempts Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  release      Release            @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  audioAsset   MediaAsset?        @relation("TrackAudio", fields: [audioAssetId], references: [id], onDelete: SetNull)
  contributors TrackContributor[]

  @@unique([releaseId, discNumber, trackNumber])
  @@index([releaseId])
  @@index([status])
}

enum TrackStatus {
  PENDING_UPLOAD // row created, presigned URL issued, file not confirmed yet
  PROCESSING // file received, validation running
  READY // validation passed
  FAILED // validation failed, see processingError
}

// Credits only. Deliberately no percentage field — royalty splits need a payout
// engine behind them, and promising a split we cannot pay is worse than not
// collecting it. Splits arrive with the payouts phase.
model TrackContributor {
  id      String @id @default(uuid())
  trackId String

  name     String
  role     ContributorRole @default(OTHER)
  roleNote String?

  // Billing order. "Asake & Olamide" is not "Olamide & Asake", and rows were
  // previously read back in insertion order, which is an accident rather than
  // a decision. Scoped per track, not per role: primaries and features are
  // composed into one credit line and their relative order matters.
  position Int @default(0)

  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
}

// The billing on the release itself — who the album is *by*.
//
// Deliberately not `Release.artistId`. That column is ownership: whose account
// this belongs to, what every catalogue query scopes through, and what has to
// keep working unchanged. Ownership and billing are the same person on most
// releases and different people on plenty of others — a label upload, a joint
// album, a compilation — so conflating them costs the ability to express any of
// those. The owner is seeded here as the first primary artist and can then be
// reordered or removed like any other row.
model ReleaseContributor {
  id        String @id @default(uuid())
  releaseId String

  name     String
  role     ContributorRole @default(OTHER)
  roleNote String?
  position Int             @default(0)

  createdAt DateTime @default(now())

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
}

enum ContributorRole {
  // The three that decide billing and the delivered title string. A primary
  // artist gets the release on their own artist page; a featured artist gets
  // the "(feat. …)" credit and a link, not a discography entry. A remixer is
  // credited alongside a `versionTitle` of "<name> Remix" and is only a primary
  // artist if the deal says so.
  PRIMARY_ARTIST
  FEATURED_ARTIST
  REMIXER

  // Credits. Stored and delivered, but not part of the artist billing, and
  // Phase 1 collects none of them through the app.
  PRODUCER
  SONGWRITER
  COMPOSER
  MIXING_ENGINEER
  MASTERING_ENGINEER
  OTHER
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

// One row per object in S3. Created when a presigned URL is issued, flipped to
// UPLOADED once the client confirms. Anything left PENDING past a day is an
// abandoned upload and can be swept.
model MediaAsset {
  id      String @id @default(uuid())
  ownerId String

  kind   AssetKind
  bucket String
  key    String    @unique

  mimeType  String?
  sizeBytes Int?
  checksum  String?

  status AssetStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  uploadedAt DateTime?
  deletedAt  DateTime?

  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  trackAudio     Track?   @relation("TrackAudio")
  releaseArtwork Release? @relation("ReleaseArtwork")
  artistAvatar   Artist?  @relation("ArtistAvatar")

  @@index([ownerId, kind])
  @@index([status, createdAt])
}

enum AssetKind {
  AUDIO
  ARTWORK
  AVATAR
}

enum AssetStatus {
  PENDING
  UPLOADED
  FAILED
  DELETED
}

// ---------------------------------------------------------------------------
// Later phases attach here, deliberately not modelled yet:
//   Analytics  — TrackMetricDaily(trackId, date, platform, streams, followers,
//                chartPosition) fed by a daily vendor pull. Add when a data
//                vendor contract exists; there is nothing to put in it now.
//   Delivery   — Delivery(releaseId, partner, externalId, state, deliveredAt)
//                plus DSP targets. Shape depends on which distribution partner
//                is signed, so modelling it now would be guesswork.
//   Payouts    — RoyaltySplit, Wallet, Payout. Needs a payment rail (Paystack /
//                Flutterwave) and a KYC decision first.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/**
 * What an administrator did, and to whom.
 * Append-only: nothing updates or deletes a row here. The point of the table is
 * to answer "who decided this, and when" months later — a log that can be
 * edited answers nothing. It exists because console decisions are contestable:
 * an artist whose release was refused, or an account that was locked out, is
 * owed a name and a date rather than a line in a server's stdout.
 */
model AdminAction {
  id          String @id @default(uuid())
  adminUserId String

  action     AdminActionType
  targetType AdminTargetType
  targetId   String

  /**
   * The substance of the decision in the reviewer's own words — the rejection
   * note, the suspension reason, the position that was granted. Copied rather
   * than referenced, so editing the release later cannot rewrite what the
   * decision said at the time.
   */
  detail String?

  createdAt DateTime @default(now())

  admin User @relation("AdminActor", fields: [adminUserId], references: [id], onDelete: Cascade)

  // The two questions asked of this table: everything that happened to one
  // thing, and everything one administrator has done.
  @@index([targetType, targetId, createdAt])
  @@index([adminUserId, createdAt])
}

enum AdminActionType {
  RELEASE_CLAIMED
  RELEASE_APPROVED
  RELEASE_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_REINSTATED
  ADMIN_CREATED
  ADMIN_POSITION_CHANGED
  ADMIN_PASSWORD_RESET
  ADMIN_SUSPENDED
  ADMIN_REINSTATED
}

enum AdminTargetType {
  RELEASE
  ACCOUNT
  ADMIN
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

/**
 * One thing that happened, addressed to one person.
 * The row is the record. Email is a copy of it that may or may not arrive —
 * the sender domain does not resolve yet, and an artist who never opens their
 * inbox still has to be able to find out why a release came back. So the centre
 * is written first and mail is best-effort on top.
 * `title` and `body` are stored rather than derived at read time. A rejection
 * quotes the reviewer's note, and re-deriving it later would let an edit to the
 * release rewrite what the artist was told.
 */
model Notification {
  id     String           @id @default(uuid())
  userId String
  type   NotificationType

  title String
  body  String

  /**
   * What tapping it opens. Null for anything not about one release.
   */
  releaseId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade rather than SetNull: a notification about a release that no longer
  // exists is a dead end, not history worth keeping.
  release Release? @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  // The two reads: the newest page for one person, and their unread count.
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationType {
  /**
   * To the artist, confirming we have it.
   */
  RELEASE_SUBMITTED
  /**
   * To the artist, after a reviewer decides.
   */
  RELEASE_APPROVED
  RELEASE_REJECTED
  /**
   * To every administrator, when something lands in the queue.
   */
  REVIEW_QUEUE_NEW
  /**
   * To whoever looks after the artist, when a track's audio fails its checks.
   * Nothing told them before this: the track went to FAILED and waited to be
   * noticed.
   */
  TRACK_AUDIO_FAILED
  /**
   * To the label, when someone accepts an invitation to one of its artists.
   */
  SEAT_ACCEPTED
}
