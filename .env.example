# Copy to .env and fill in. Never commit the real file.

# ── Database (Neon) ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# Two different random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
# Comma-separated list of browser origins allowed by CORS. The mobile app sends
# no Origin header and does not need to be listed.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── File storage (Cloudflare R2, or any S3-compatible host) ──────────────────
# R2: endpoint is https://<account-id>.r2.cloudflarestorage.com and region is
# "auto". For plain AWS S3, leave S3_ENDPOINT blank and set the real region.
S3_BUCKET=frndshq-uploads
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave unset: defaults to path-style when S3_ENDPOINT is present.
S3_FORCE_PATH_STYLE=
# Stored audio files allowed per account while nothing is being distributed.
MAX_AUDIO_UPLOADS_PER_ARTIST=100

# ── Email (Mailjet) ──────────────────────────────────────────────────────────
# Leave blank in development: MailService logs the message and prints OTPs to
# the terminal instead of sending.
MAILJET_API_PUBLIC_KEY=
MAILJET_API_PRIVATE_KEY=
SENDER_EMAIL_ADDRESS=
SENDER_NAME=FRNDSHQ
SUPPORT_EMAIL_ADDRESS=
